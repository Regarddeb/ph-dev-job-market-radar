# Copy to .env at the repo root (never commit .env). One file serves scraper/ and dashboard/.
# Easiest: `neon init` / `neon env pull` (writes owner URLs), then
#   uv run --project scraper python scripts/setup_db_roles.py
# which creates the least-privilege roles and rewrites the three URLs below.
# Neon gives each endpoint a pooled host (ep-…-pooler.…) and a direct host.

# Read-write app role, POOLED host. Used by the Python scraper (pipeline, aggregate, retention).
# GitHub Actions secret: DATABASE_URL
DATABASE_URL=postgresql://jobradar_rw:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Owner role, DIRECT (non-pooled) host. Used only by Prisma Migrate (migrate dev/deploy, db seed).
# GitHub Actions secret: MIGRATE_DATABASE_URL
MIGRATE_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Read-only role, POOLED host. Used by the local dashboard and the `postgres` MCP server.
# On Vercel this same value is set as DATABASE_URL.
JOBRADAR_READONLY_DATABASE_URL=postgresql://jobradar_ro:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Identifying User-Agent for all scraper requests (name, contact URL or email).
# GitHub Actions secret: SCRAPER_USER_AGENT
SCRAPER_USER_AGENT=job-radar/0.1 (+https://github.com/YOUR_USER/job-radar; you@example.com)

# Shared secret for POST /api/revalidate. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# GitHub Actions secret + Vercel env: REVALIDATE_SECRET
REVALIDATE_SECRET=change-me

# Dashboard base URL the workflow calls after a run. GitHub Actions secret or variable: DASHBOARD_URL
DASHBOARD_URL=http://localhost:3000
