{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm format *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./dashboard/.env)",
      "Read(./dashboard/.env.local)",
      "WebFetch(domain:jobstreet.com)",
      "WebFetch(domain:www.jobstreet.com.ph)",
      "WebFetch(domain:ph.jobstreet.com)",
      "WebFetch(domain:jobsdb.com)",
      "WebFetch(domain:seek.com.au)",
      "WebFetch(domain:linkedin.com)",
      "WebFetch(domain:www.linkedin.com)",
      "WebFetch(domain:indeed.com)",
      "WebFetch(domain:ph.indeed.com)",
      "WebFetch(domain:www.indeed.com)",
      "WebFetch(domain:upwork.com)",
      "WebFetch(domain:www.upwork.com)",
      "WebFetch(domain:onlinejobs.ph)",
      "WebFetch(domain:www.onlinejobs.ph)",
      "WebFetch(domain:remotive.com)"
    ]
  },
  "enabledMcpjsonServers": ["postgres", "playwright"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_files.py"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/format_file.py"],
            "timeout": 120
          }
        ]
      }
    ]
  }
}
